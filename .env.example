# Public URL of the app, no trailing slash. Used for links, QR codes and the Origin (CSRF) check.
APP_URL=http://localhost:3000

# PostgreSQL. DATABASE_URL is the POOLED connection used by the app (Neon: the "-pooler" host).
# DATABASE_URL_UNPOOLED is the direct connection used by migrations and seeds.
DATABASE_URL=postgres://ussmf:password@localhost:5432/ussmf
DATABASE_URL_UNPOOLED=postgres://ussmf:password@localhost:5432/ussmf

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# S3-compatible private bucket (Cloudflare R2, AWS S3, Supabase Storage, MinIO...).
# R2 example: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com and S3_REGION=auto
# AWS S3: leave S3_ENDPOINT empty and set S3_REGION (e.g. us-east-1).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=ussmf-medical
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Upstash Redis for rate limiting across serverless instances.
# Optional in development (an in-memory limiter is used); required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SMTP for transactional email. Optional in development (emails are printed to the console).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="U.S.S.M.F. <no-reply@ussmf.org>"
ADMIN_EMAIL=info@ussmf.org

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>". Required in production.
CRON_SECRET=

# Optional. Set to "false" to hide the demo sample IDs under the homepage tracker and verifier.
NEXT_PUBLIC_DEMO_SAMPLES=true
