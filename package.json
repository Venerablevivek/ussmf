{
  "name": "ussmf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "U.S.S.M.F. Air Sports Medical Fitness Certificate platform",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "knex": "node --conditions=react-server node_modules/knex/bin/cli.js --knexfile knexfile.js",
    "db:migrate": "npm run knex -- migrate:latest",
    "db:rollback": "npm run knex -- migrate:rollback",
    "db:seed": "npm run knex -- seed:run",
    "db:reset": "npm run knex -- migrate:rollback --all && npm run db:migrate && npm run db:seed",
    "vercel-build": "npm run db:migrate && next build",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@next/env": "^16.4.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "file-type": "^22.3.0",
    "jose": "^6.2.14",
    "knex": "^3.3.0",
    "motion": "^14.8.0",
    "next": "^16.4.3",
    "nodemailer": "^10.3.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.3",
    "@tailwindcss/postcss": "^4.3.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3"
  }
}
